# Configurações do Banco de Dados
DATABASE_URL=sqlite:///./aurora.db

# Configurações de Segurança e Sessão
SECRET_KEY=change-me-in-production
FRONTEND_URL=http://localhost:5173

# Recuperação de senha por e-mail (Gmail: use senha de aplicativo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aurora
SMTP_USE_TLS=true

# IA (Google Gemini)
GEMINI_API_KEY=

# Integração Google OAuth (Google Calendar)
# Obtenha em: https://console.cloud.google.com/apis/credentials
# Tipo da credencial: ID do cliente OAuth 2.0 > Aplicativo da Web
# Origens JavaScript autorizadas: http://localhost:5173
# URI de Redirecionamento autorizada: http://localhost:8000/connect/google/callback
# Depois de alterar estas variáveis, reinicie o backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notificações Push (Web Push / VAPID)
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_CLAIMS_EMAIL=mailto:aurora@maycon.dev
